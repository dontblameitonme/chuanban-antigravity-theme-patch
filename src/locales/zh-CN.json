  "patterns": [
    {
      "regex": "^(\\d+)\\s+active\\s+conversations$",
      "flags": "i",
      "replace": "$1 个进行中的会话"
    },
    {
      "regex": "^(\\d+)\\s+files?\\s+changed$",
      "flags": "i",
      "replace": "$1 个文件变更"
    },
    {
      "regex": "^Show\\s+(\\d+)\\s+breakdowns?$",
      "flags": "i",
      "replace": "展开明细 ($1 项)"
    },
    {
      "regex": "^Worked for\\s+(\\d+[smhd])$",
      "flags": "i",
      "replace": "已工作 $1"
    },
    {
      "regex": "^Thought for\\s+(\\d+[smhd])$",
      "flags": "i",
      "replace": "已思考 $1"
    }
